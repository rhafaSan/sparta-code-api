// use prisma-next

model User {
  id   Uuid   @id @default(uuid())
  name String
  email String @unique
  username String @unique
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")

  workouts        Workout[]
  workoutSessions WorkoutSession[]
  authSessions AuthSession[]

  @@map("users")
}

model AuthSession {
  id Uuid @id @default(uuid())
  userId Uuid @map("user_id")
  accessTokenHash String @unique @map("access_token_hash")
  accessExpiresAt DateTime @map("access_expires_at")
  idleExpiresAt DateTime @map("idle_expires_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

model RefreshToken {
  id Uuid @id @default(uuid())
  authSessionId Uuid @map("auth_session_id")
  tokenHash String @unique @map("token_hash")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")

  authSession AuthSession @relation(fields: [authSessionId], references: [id])

  @@index([authSessionId])
  @@map("refresh_tokens")
}

model Exercise {
  id          Uuid    @id @default(uuid())
  name        String
  description String?

  muscleGroup String?
    @map("muscle_group")

  isActive Boolean
    @default(true)
    @map("is_active")

  createdAt DateTime
    @default(now())
    @map("created_at")

  workoutExercises WorkoutExercise[]
  muscles ExerciseMuscle[]

  @@index([name])

  @@map("exercises")
}

model MuscleGroup {
  id Uuid @id @default(uuid())
  slug String @unique
  name String
  view String
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  exercises ExerciseMuscle[]

  @@map("muscle_groups")
}

model ExerciseMuscle {
  id Uuid @id @default(uuid())
  exerciseId Uuid @map("exercise_id")
  muscleGroupId Uuid @map("muscle_group_id")
  role String
  createdAt DateTime @default(now()) @map("created_at")

  exercise Exercise @relation(fields: [exerciseId], references: [id])
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  @@unique([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
  @@map("exercise_muscles")
}

model Workout {
  id Uuid
    @id
    @default(uuid())

  userId Uuid
    @map("user_id")

  name  String
  notes String?

  isActive Boolean
    @default(true)
    @map("is_active")

  createdAt DateTime
    @default(now())
    @map("created_at")

  // DELETE: RESTRICT
  // Não queremos apagar um usuário automaticamente
  // quando um Workout existir.
  user User @relation(
    fields: [userId],
    references: [id]
  )

  workoutExercises WorkoutExercise[]
  workoutSessions  WorkoutSession[]

  @@index([userId])
  @@index([userId, isActive])

  @@map("workouts")
}

model WorkoutExercise {
  id Uuid
    @id
    @default(uuid())

  workoutId Uuid
    @map("workout_id")

  exerciseId Uuid
    @map("exercise_id")

  exerciseOrder Int
    @map("exercise_order")

  plannedSets Int
    @map("planned_sets")

  plannedReps Int
    @map("planned_reps")

  restSeconds Int?
    @map("rest_seconds")

  notes String?

  isActive Boolean
    @default(true)
    @map("is_active")

  createdAt DateTime
    @default(now())
    @map("created_at")

  // DELETE desejado: CASCADE
  //
  // Se um Workout for realmente apagado e não possuir
  // histórico, seus WorkoutExercise também podem ser apagados.
  workout Workout @relation(
    fields: [workoutId],
    references: [id]
  )

  // DELETE: RESTRICT
  //
  // Não queremos apagar o vínculo/histórico automaticamente
  // se um Exercise for removido.
  exercise Exercise @relation(
    fields: [exerciseId],
    references: [id]
  )

  exerciseSessions ExerciseSession[]

  @@unique([workoutId, exerciseOrder])

  @@index([workoutId])
  @@index([exerciseId])
  @@index([workoutId, isActive])

  @@map("workout_exercises")
}

model WorkoutSession {
  id Uuid
    @id
    @default(uuid())

  userId Uuid
    @map("user_id")

  workoutId Uuid
    @map("workout_id")

  startedAt DateTime
    @default(now())
    @map("started_at")

  finishedAt DateTime?
    @map("finished_at")

  notes String?

  createdAt DateTime
    @default(now())
    @map("created_at")

  // DELETE: RESTRICT
  //
  // Histórico de treino impede remoção do usuário.
  user User @relation(
    fields: [userId],
    references: [id]
  )

  // DELETE: RESTRICT
  //
  // Workout com histórico não deve ser apagado.
  workout Workout @relation(
    fields: [workoutId],
    references: [id]
  )

  exerciseSessions ExerciseSession[]

  @@index([userId])
  @@index([workoutId])
  @@index([startedAt])
  @@index([userId, startedAt])

  @@map("workout_sessions")
}

model ExerciseSession {
  id Uuid
    @id
    @default(uuid())

  workoutSessionId Uuid
    @map("workout_session_id")

  workoutExerciseId Uuid
    @map("workout_exercise_id")

  exerciseOrder Int
    @map("exercise_order")

  plannedSets Int
    @map("planned_sets")

  plannedReps Int
    @map("planned_reps")

  restSeconds Int?
    @map("rest_seconds")

  completed Boolean
    @default(false)

  notes String?

  createdAt DateTime
    @default(now())
    @map("created_at")

  // DELETE desejado: CASCADE
  //
  // Se deliberadamente apagarmos uma WorkoutSession,
  // suas ExerciseSession também devem desaparecer.
  workoutSession WorkoutSession @relation(
    fields: [workoutSessionId],
    references: [id]
  )

  // DELETE: RESTRICT
  //
  // Mantemos o WorkoutExercise porque a sessão histórica
  // referencia exatamente aquela configuração de exercício.
  workoutExercise WorkoutExercise @relation(
    fields: [workoutExerciseId],
    references: [id]
  )

  sets ExerciseSet[]

  @@unique([workoutSessionId, workoutExerciseId])

  @@index([workoutSessionId])
  @@index([workoutExerciseId])

  @@map("exercise_sessions")
}

model ExerciseSet {
  id Uuid
    @id
    @default(uuid())

  exerciseSessionId Uuid
    @map("exercise_session_id")

  setNumber Int
    @map("set_number")

  weight Decimal?
  reps   Int?

  completed Boolean
    @default(false)

  createdAt DateTime
    @default(now())
    @map("created_at")

  // DELETE desejado: CASCADE
  //
  // Se uma ExerciseSession for apagada,
  // suas séries também devem ser apagadas.
  exerciseSession ExerciseSession @relation(
    fields: [exerciseSessionId],
    references: [id]
  )

  @@unique([exerciseSessionId, setNumber])

  @@index([exerciseSessionId])

  @@map("exercise_sets")
}
